{
  "rules": {
    "rooms": {
      "$roomId": {
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() == auth.uid) || (data.child('hostUid').val() == auth.uid && !newData.exists()))",
        "hostUid": {
          ".read": false,
          ".write": false
        },
        "status": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid"
        },
        "settings": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid"
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (root.child('rooms').child($roomId).child('hostUid').val() == auth.uid || (auth.uid == $uid && root.child('rooms').child($roomId).child('status').val() == 'lobby' && !newData.exists()))"
          }
        },
        "joinRequests": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid == $uid || root.child('rooms').child($roomId).child('hostUid').val() == auth.uid)",
            ".write": "auth != null && ((auth.uid == $uid && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists()))) || root.child('rooms').child($roomId).child('hostUid').val() == auth.uid)"
          }
        },
        "confirmations": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid",
          "$uid": {
            ".write": "auth != null && ((auth.uid == $uid && root.child('rooms').child($roomId).child('players').child($uid).exists() && root.child('rooms').child($roomId).child('status').val() == 'playing') || root.child('rooms').child($roomId).child('hostUid').val() == auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'kind', 'id', 'revealKey', 'revealPhase']) && newData.child('uid').val() == $uid && newData.child('kind').val() == 'next')"
          }
        },
        "actions": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid",
          "$actionId": {
            ".write": "auth != null && ((!data.exists() && auth.uid == newData.child('uid').val() && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()) || root.child('rooms').child($roomId).child('hostUid').val() == auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'kind']) && newData.child('uid').val() == auth.uid && (newData.child('kind').val() == 'pick' || newData.child('kind').val() == 'envelope' || newData.child('kind').val() == 'next' || newData.child('kind').val() == 'skip' || (newData.child('kind').val() == 'leave' && root.child('rooms').child($roomId).child('status').val() == 'playing')))"
          }
        }
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (root.child('rooms').child($roomId).child('hostUid').val() == auth.uid || (!newData.exists() && !root.child('rooms').child($roomId).exists()))",
        ".validate": "!newData.exists() || (newData.hasChildren(['host', 'count', 'max', 'pickLimit', 'createdAt', 'updatedAt']) && newData.child('host').isString() && newData.child('host').val().length <= 16 && newData.child('count').isNumber() && newData.child('max').isNumber() && newData.child('pickLimit').isNumber() && (!newData.child('name').exists() || (newData.child('name').isString() && newData.child('name').val().length <= 20)) && (!newData.child('limits').exists() || (newData.child('limits').isString() && newData.child('limits').val().length <= 120)))",
        "$other": {
          ".validate": "$other == 'host' || $other == 'count' || $other == 'max' || $other == 'pickLimit' || $other == 'limits' || $other == 'name' || $other == 'createdAt' || $other == 'updatedAt'"
        }
      }
    },
    "polls": {
      "voters": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          "$kind": {
            ".write": "auth != null && auth.uid == $uid && ($kind == 'g' || $kind == 'm')",
            ".validate": "newData.hasChildren(['day', 'w', 'm', 'dk', 'wk', 'mk', 'n', 'item']) && newData.child('dk').isString() && newData.child('dk').val().matches(/^d[0-9]{1,7}$/) && newData.child('wk').isString() && newData.child('wk').val().matches(/^w[0-9]{1,7}$/) && newData.child('mk').isString() && newData.child('mk').val().matches(/^m[0-9]{1,7}$/) && newData.child('day').isNumber() && newData.child('day').val() * 86400000 - 32400000 <= now + 120000 && now - 120000 < (newData.child('day').val() + 1) * 86400000 - 32400000 && newData.child('w').val() * 7 <= newData.child('day').val() + 3 && newData.child('day').val() + 3 < newData.child('w').val() * 7 + 7 && (newData.child('m').val() - 23640) * 30.436875 - newData.child('day').val() < 35 && newData.child('day').val() - (newData.child('m').val() - 23640) * 30.436875 < 35 && newData.child('item').isString() && newData.child('item').val().length <= 200 && newData.child('n').isNumber() && newData.child('n').val() <= 3 && ((data.exists() && data.child('day').val() == newData.child('day').val() && newData.child('n').val() == data.child('n').val() + 1) || ((!data.exists() || data.child('day').val() != newData.child('day').val()) && newData.child('n').val() == 1))",
            "$other": {
              ".validate": "$other == 'day' || $other == 'w' || $other == 'm' || $other == 'dk' || $other == 'wk' || $other == 'mk' || $other == 'n' || $other == 'item'"
            }
          }
        }
      },
      "tally": {
        ".read": "auth != null",
        "$kind": {
          "$period": {
            "$item": {
              ".write": "auth != null && ($kind == 'g' || $kind == 'm')",
              ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1)) && (newData.parent().parent().parent().parent().child('voters').child(auth.uid).child($kind).child('n').val() != root.child('polls').child('voters').child(auth.uid).child($kind).child('n').val() || newData.parent().parent().parent().parent().child('voters').child(auth.uid).child($kind).child('day').val() != root.child('polls').child('voters').child(auth.uid).child($kind).child('day').val()) && newData.parent().parent().parent().parent().child('voters').child(auth.uid).child($kind).child('item').val() == $item && ($period == 'all' || $period == newData.parent().parent().parent().parent().child('voters').child(auth.uid).child($kind).child('dk').val() || $period == newData.parent().parent().parent().parent().child('voters').child(auth.uid).child($kind).child('wk').val() || $period == newData.parent().parent().parent().parent().child('voters').child(auth.uid).child($kind).child('mk').val())"
            }
          }
        }
      },
      "total": {
        ".read": "auth != null",
        "$kind": {
          "$period": {
            ".write": "auth != null && ($kind == 'g' || $kind == 'm')",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1)) && (newData.parent().parent().parent().child('voters').child(auth.uid).child($kind).child('n').val() != root.child('polls').child('voters').child(auth.uid).child($kind).child('n').val() || newData.parent().parent().parent().child('voters').child(auth.uid).child($kind).child('day').val() != root.child('polls').child('voters').child(auth.uid).child($kind).child('day').val()) && ($period == 'all' || $period == newData.parent().parent().parent().child('voters').child(auth.uid).child($kind).child('dk').val() || $period == newData.parent().parent().parent().child('voters').child(auth.uid).child($kind).child('wk').val() || $period == newData.parent().parent().parent().child('voters').child(auth.uid).child($kind).child('mk').val())"
          }
        }
      }
    }
  }
}

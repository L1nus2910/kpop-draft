{
  "rules": {
    "rooms": {
      "$roomId": {
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() == auth.uid) || (data.child('hostUid').val() == auth.uid && !newData.exists()))",
        "hostUid": {
          ".read": false,
          ".write": false
        },
        "status": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid"
        },
        "settings": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid"
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (root.child('rooms').child($roomId).child('hostUid').val() == auth.uid || (auth.uid == $uid && root.child('rooms').child($roomId).child('status').val() == 'lobby' && !newData.exists()))"
          }
        },
        "joinRequests": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid == $uid || root.child('rooms').child($roomId).child('hostUid').val() == auth.uid)",
            ".write": "auth != null && ((auth.uid == $uid && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists()))) || root.child('rooms').child($roomId).child('hostUid').val() == auth.uid)"
          }
        },
        "confirmations": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid",
          "$uid": {
            ".write": "auth != null && ((auth.uid == $uid && root.child('rooms').child($roomId).child('players').child($uid).exists() && root.child('rooms').child($roomId).child('status').val() == 'playing') || root.child('rooms').child($roomId).child('hostUid').val() == auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'kind', 'id', 'revealKey', 'revealPhase']) && newData.child('uid').val() == $uid && newData.child('kind').val() == 'next')"
          }
        },
        "actions": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() == auth.uid",
          "$actionId": {
            ".write": "auth != null && ((!data.exists() && auth.uid == newData.child('uid').val() && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()) || root.child('rooms').child($roomId).child('hostUid').val() == auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'kind']) && newData.child('uid').val() == auth.uid && (newData.child('kind').val() == 'pick' || newData.child('kind').val() == 'envelope' || newData.child('kind').val() == 'next' || newData.child('kind').val() == 'skip' || (newData.child('kind').val() == 'leave' && root.child('rooms').child($roomId).child('status').val() == 'playing')))"
          }
        }
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (root.child('rooms').child($roomId).child('hostUid').val() == auth.uid || (!newData.exists() && !root.child('rooms').child($roomId).exists()))",
        ".validate": "!newData.exists() || (newData.hasChildren(['host', 'count', 'max', 'pickLimit', 'createdAt', 'updatedAt']) && newData.child('host').isString() && newData.child('host').val().length <= 16 && newData.child('count').isNumber() && newData.child('max').isNumber() && newData.child('pickLimit').isNumber() && (!newData.child('limits').exists() || (newData.child('limits').isString() && newData.child('limits').val().length <= 120)))",
        "$other": {
          ".validate": "$other == 'host' || $other == 'count' || $other == 'max' || $other == 'pickLimit' || $other == 'limits' || $other == 'createdAt' || $other == 'updatedAt'"
        }
      }
    }
  }
}

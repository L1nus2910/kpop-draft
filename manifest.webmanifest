{
  "id": "./",
  "name": "KDraft — K-POP Draft",
  "short_name": "KDraft",
  "description": "推しでつくる、夢のドラフト。K-POPガールズグループのメンバーを指名してチームを組む、非公式ファン制作のドラフトゲーム。",
  "lang": "ja",
  "dir": "ltr",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f6f4fa",
  "theme_color": "#f6f4fa",
  "categories": [
    "games",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "assets/kdraft-192-v3.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/kdraft-512-v4.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/kdraft-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/kdraft-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "AIとドラフト",
      "short_name": "AIドラフト",
      "url": "./#/setup/ai",
      "icons": [
        {
          "src": "assets/kdraft-192-v3.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "オンラインで遊ぶ",
      "short_name": "オンライン",
      "url": "./#/setup/online",
      "icons": [
        {
          "src": "assets/kdraft-192-v3.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "過去のドラフト",
      "short_name": "履歴",
      "url": "./#/history",
      "icons": [
        {
          "src": "assets/kdraft-192-v3.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}